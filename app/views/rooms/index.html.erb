<h1 style="text-align:center; margin:20px 0;">DM一覧</h1>

<div style="max-width:600px; margin:0 auto;">
  <% if @rooms.any? %>
    <% @rooms.each do |room| %>
      <% other_user = room.users.where.not(id: current_user.id).first %>
      <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:15px; padding:10px; background:#fff; border-radius:12px; box-shadow:0 2px 6px rgba(0,0,0,0.1);">
        
        <!-- ユーザー情報 -->
        <div style="display:flex; align-items:center; gap:10px;">
          <!-- アイコン -->
          <div style="width:50px; height:50px; border-radius:50%; overflow:hidden; background:#ddd; display:flex; align-items:center; justify-content:center;">
            <% if other_user.avatar.attached? %>
              <%= image_tag other_user.avatar.variant(resize_to_limit: [50,50]), style:"width:100%; height:100%; object-fit:cover;" %>
            <% else %>
              <div style="font-size:24px;">👤</div>
            <% end %>
          </div>
          <!-- 名前 -->
          <%= link_to other_user.display_name_or_default, room_path(room), style:"text-decoration:none; color:#333; font-weight:bold;" %>
        </div>

        <!-- ルーム削除ボタン -->
        <div>
          <%= button_to "🗑 削除", room_path(room), method: :delete, data: { confirm: "本当に削除しますか？" }, 
            style: "background:#f8d7da; color:#721c24; border:1px solid #f5c6cb; border-radius:6px; padding:4px 8px; cursor:pointer;" %>
        </div>

      </div>
    <% end %>
  <% else %>
    <p style="text-align:center; color:#666; padding:40px;">DMはまだありません</p>
  <% end %>
</div>
