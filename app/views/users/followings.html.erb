<h1><%= @user.display_name_or_default %>がフォローしている人</h1>

<% if @users.any? %>
  <ul style="list-style:none; padding:0;">
    <% @users.each do |user| %>
      <li style="display:flex; align-items:center; margin-bottom:10px;">
        <%= link_to user_path(user), style: "display:flex; align-items:center; text-decoration:none; color:inherit;" do %>
          <div style="width:40px; height:40px; border-radius:50%; overflow:hidden; background:#ddd; margin-right:10px;">
            <% if user.avatar.attached? %>
              <%= image_tag user.avatar.variant(resize_to_limit: [40,40]), style: "width:100%; height:100%; object-fit:cover;" %>
            <% else %>
              <div style="width:40px; height:40px; display:flex; align-items:center; justify-content:center; font-size:20px; color:#aaa;">👤</div>
            <% end %>
          </div>
          <span><%= user.display_name_or_default %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
<% else %>
  <p>フォローしている人はいません。</p>
<% end %>
