<h1 style="text-align:center;">フォロワー</h1>

<div style="max-width:600px; margin:0 auto;">
  <% if @users.any? %>
    <% @users.each do |user| %>
      <div style="display:flex; align-items:center; gap:10px; margin-bottom:10px;">
        <!-- ユーザーアイコン -->
        <div style="width:40px; height:40px; border-radius:50%; overflow:hidden; background:#ddd;">
          <% if user.avatar.attached? %>
            <%= image_tag user.avatar.variant(resize_to_limit: [40,40]), style:"width:100%; height:100%; object-fit:cover;" %>
          <% else %>
            <div style="width:40px; height:40px; display:flex; align-items:center; justify-content:center;">👤</div>
          <% end %>
        </div>
        <!-- ユーザー名 -->
        <%= link_to user.display_name_or_default, user_path(user), style:"text-decoration:none; color:#333;" %>
      </div>
    <% end %>
  <% else %>
    <p style="text-align:center; color:#666;">フォロワーはいません</p>
  <% end %>
</div>
